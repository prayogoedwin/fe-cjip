# Copy ke .env.local lalu isi nilainya
# cp .env.example .env.local

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API v3 (Laravel) — tanpa trailing slash di akhir path /api
# Contoh lokal (artisan serve): http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api

# Log API request/response di terminal Next (1=on, 0=off)
NEXT_PUBLIC_API_DEBUG=1

# Google Analytics 4 (Measurement ID, contoh: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (visible widget)
# Buat widget di https://dash.cloudflare.com/?to=/:account/turnstile
# Mode: Managed, Appearance: Always
# Dev test key (selalu lolos): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only — jangan expose ke client
# TURNSTILE_SECRET_KEY=
# API_SECRET_KEY=
